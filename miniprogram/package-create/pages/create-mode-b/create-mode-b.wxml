<view class="page modeb-page anim-page-enter">
  <!-- 顶部橘色背景区域 -->
  <view class="modeb-header-bg">
    <!-- 头部：橘仔提示 -->
    <view class="modeb-header">
      <view class="cat-hint anim-breathe">
        <image class="cat-img" src="{{imagePaths.icons.juzeAvatar}}" mode="aspectFit" />
        <view class="speech-bubble">
          <text class="bubble-text">你们来定</text>
        </view>
      </view>
      <text class="header-sub">让大家先选口味，你再决定</text>
    </view>
  </view>

  <!-- 页面内容区域 -->
  <view class="modeb-content">

  <!-- 表单卡片 -->
  <view class="form-card card anim-slide-up">
    <!-- 聚会标题和聚会地点范围 - 同一行 -->
    <view class="form-group combined-fields">
      <view class="field-section">
        <text class="section-label">聚会标题</text>
        <input class="input field-input" placeholder="如：周五部门聚会" value="{{title}}" bindinput="onTitleInput" />
      </view>
      <view class="divider"></view>
      <view class="field-section location-section">
        <text class="section-label">聚会地点范围</text>
        <view class="location-content-compact">
          <input 
            class="input field-input location-input-compact" 
            placeholder="如：朝阳区" 
            value="{{locationText}}"
            bindinput="onLocationInput"
          />
          <view class="location-map-btn-compact" bindtap="onChooseLocation">
            <image class="location-icon" src="{{imagePaths.icons.location}}" mode="aspectFit"/>
          </view>
        </view>
      </view>
    </view>

    <!-- 聚会时间和投票截止时间 - 同一行，月日|时分结构 -->
    <view class="form-group combined-dates">
      <view class="date-section">
        <text class="section-label">聚餐时间</text>
        <view class="date-inputs">
          <input class="input small" type="text" maxlength="6" placeholder="月日" bindinput="onDinnerDateInput" bindblur="onDinnerDateBlur" value="{{dinnerDate}}"/>
          <text class="separator">|</text>
          <input class="input small" type="text" maxlength="6" placeholder="时分" bindinput="onDinnerTimeInput" bindblur="onDinnerTimeBlur" value="{{dinnerTime}}"/>
        </view>
      </view>
      <view class="divider"></view>
      <view class="date-section">
        <text class="section-label">投票截止时间</text>
        <view class="date-inputs">
          <input class="input small" type="text" maxlength="6" placeholder="月日" bindinput="onDeadlineDateInput" bindblur="onDeadlineDateBlur" value="{{deadlineDate}}"/>
          <text class="separator">|</text>
          <input class="input small" type="text" maxlength="6" placeholder="时分" bindinput="onDeadlineTimeInput" bindblur="onDeadlineTimeBlur" value="{{deadlineTime}}"/>
        </view>
      </view>
    </view>

    <!-- 打开付款码 - 单独一行 -->
    <view class="form-group">
      <text class="section-label">打开付款码的姿势</text>
      <view class="payment-options-compact">
        <view class="payment-option {{paymentMode === 'AA' ? 'selected' : ''}}" data-mode="AA" bindtap="onPaymentModeChange">
          <text class="option-text">AA平摊</text>
        </view>
        <view class="payment-option {{paymentMode === 'treat' ? 'selected' : ''}}" data-mode="treat" bindtap="onPaymentModeChange">
          <text class="option-text">喵大佬请客</text>
        </view>
        <view class="payment-option {{paymentMode === 'hidden' ? 'selected' : ''}}" data-mode="hidden" bindtap="onPaymentModeChange">
          <text class="option-text">空白，不显示</text>
        </view>
      </view>
      <text class="payment-hint" wx:if="{{paymentMode === 'hidden'}}">选中后成员投票时不会看到付款方式，默认发起人请客</text>
    </view>

<!-- 隐私设置 - 可见性 -->
<view class="form-group privacy-section">
<text class="section-label">活动可见性</text>
<view class="visibility-options">
<view class="visibility-option {{visibility === 'friends' ? 'selected' : ''}}" data-value="friends" bindtap="onVisibilityChange">
<text class="option-title">仅好友可见</text>
</view>
<view class="visibility-divider"></view>
<view class="visibility-option {{visibility === 'share' ? 'selected' : ''}}" data-value="share" bindtap="onVisibilityChange">
<text class="option-title">仅通过分享</text>
</view>
</view>
</view>

    <!-- 匿名投票、房间密码、餐厅推荐 - 同一行对齐 -->
    <view class="form-group switch-row-combined">
      <view class="switch-item">
        <text class="switch-label">匿名投票</text>
        <view class="switch-control">
          <switch checked="{{isAnonymous}}" bindchange="onAnonymousChange" color="#D4652A" />
          <text class="switch-status">{{isAnonymous ? '已开启' : '已关闭'}}</text>
        </view>
      </view>
      <view class="switch-divider"></view>
      <view class="switch-item">
        <text class="switch-label">房间密码</text>
        <view class="switch-control">
          <switch checked="{{needPassword}}" bindchange="onPasswordSwitchChange" color="#D4652A" />
          <text class="switch-status">{{needPassword ? '已开启' : '已关闭'}}</text>
        </view>
      </view>
    </view>

    <!-- 餐厅推荐开关 -->
    <view class="form-group recommend-switch-section">
      <view class="recommend-switch-header">
        <view class="recommend-switch-title">
          <text class="section-label">投票后推荐餐厅</text>
          <text class="recommend-switch-hint">根据口味偏好和位置自动推荐</text>
        </view>
        <switch checked="{{enableRestaurantRecommend}}" bindchange="onRecommendSwitchChange" color="#D4652A" />
      </view>
    </view>

    <!-- 房间密码输入框 -->
    <view class="form-group password-input-section" wx:if="{{needPassword}}">
      <input 
        class="input password-input" 
        type="text" 
        maxlength="6"
        placeholder="请输入4-6位密码" 
        value="{{roomPassword}}"
        bindinput="onPasswordInput"
      />
      <text class="password-hint">加入房间时需要输入此密码</text>
    </view>
  </view>

  <!-- 决策说明：合并结果生效规则和流程说明 -->
  <view class="decision-section anim-slide-up" style="animation-delay:0.1s">
    <text class="decision-title">决策说明</text>
    <view class="decision-list">
      <view class="decision-item">
        <view class="decision-dot"></view>
        <text class="decision-text">成员先选择口味偏好</text>
      </view>
      <view class="decision-item">
        <view class="decision-dot"></view>
        <text class="decision-text">你根据统计结果选店</text>
      </view>
      <view class="decision-item">
        <view class="decision-dot"></view>
        <text class="decision-text">票数最高自动敲定，如平票发起人有最终确认权</text>
      </view>
      <view class="decision-item">
        <view class="decision-dot"></view>
        <text class="decision-text">推送结果给所有人</text>
      </view>
    </view>
  </view>

  </view>

  <!-- 底部按钮 -->
  <view class="bottom-panel safe-bottom">
    <button class="btn btn-primary submit-btn {{canSubmit ? '' : 'btn-disabled'}}" bindtap="_lockedCreateRoom">
      生成房间
    </button>
  </view>

  <!-- 数据保留提示弹窗 -->
  <view class="popup" wx:if="{{showDataRetentionTip}}">
    <view class="popup-mask" bindtap="closeDataRetentionTip"></view>
    <view class="popup-content data-retention-content">
      <text class="popup-title">数据保留说明</text>
      <view class="retention-info">
        <text class="retention-text">为保护您的隐私和减少数据堆积：</text>
        <view class="retention-list">
          <view class="retention-item">
            <text class="item-icon check-icon">✓</text>
            <text class="item-text">进行中的活动永久保留</text>
          </view>
          <view class="retention-item">
            <text class="item-icon time-icon">·</text>
            <text class="item-text">已结束的活动30天后自动清理</text>
          </view>
          <view class="retention-item">
            <text class="item-icon link-icon">·</text>
            <text class="item-text">分享链接7天有效期</text>
          </view>
        </view>
        <text class="retention-notice">创建活动即表示您同意此数据保留政策</text>
        
        <!-- 下次不再显示选项 -->
        <view class="agree-option" bindtap="toggleAgreeDefault">
          <view class="checkbox {{agreeDefault ? 'checked' : ''}}">
            <text wx:if="{{agreeDefault}}" class="check-mark">✓</text>
          </view>
          <text class="agree-text">下次不再显示，默认同意以上规则</text>
        </view>
      </view>
      <button class="btn-confirm" bindtap="closeDataRetentionTip">我知道了</button>
    </view>
  </view>
</view>
