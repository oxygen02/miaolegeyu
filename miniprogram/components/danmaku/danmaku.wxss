/* ========== 弹幕组件 - 最终版 ========== */

/* 容器 */
.dm-wrap {
  width: 100%;
  height: 100%;
  position: relative;
  pointer-events: none;
}

/* 恢复交互区域 */
.dm-wrap .dm-item,
.dm-wrap .dm-input-row,
.dm-wrap .dm-input-box { pointer-events: auto; }

/* ========== 轨道区：垂直居中，3条轨道 ========== */
.dm-tracks {
  position: absolute;
  top: 20%;
  left: 0;
  right: 0;
  bottom: 25%;
  overflow: visible;
}

/* ========== 弹幕项：使用 transform 硬件加速 ========== */
.dm-item {
  position: absolute;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  z-index: 5;
  /* 初始在右侧外，使用 transform 硬件加速 */
  transform: translate3d(375px, 0, 0);
  animation: dm-fly linear forwards;
  /* 强制 GPU 层 */
  will-change: transform;
}

/* 核心动画：使用 translate3d 实现平滑移动
 * 375px 是 iPhone 标准逻辑宽度，覆盖大多数设备
 * 从 +375px（右侧外）移动到 -375px（左侧外）
 */
@keyframes dm-fly {
  0%   { transform: translate3d(375px, 0, 0); opacity: 0; }
  5%   { opacity: 1; transform: translate3d(375px, 0, 0); }
  85%  { opacity: 1; transform: translate3d(-375px, 0, 0); }
  95%  { opacity: 1; transform: translate3d(-375px, 0, 0); }
  100% { transform: translate3d(-500px, 0, 0); opacity: 0; }
}

/* 暂停 */
.dm-wrap.paused .dm-item { animation-play-state: paused !important; }

/* 头像 */
.dm-avatar {
  width: 34rpx; height: 34rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
  border: 2rpx solid rgba(255,255,255,0.7);
}
.dm-avatar-def {
  background: linear-gradient(135deg, #FF6B35, #FF3B30);
  position: relative; overflow: hidden;
}
.dm-avatar-def::after {
  content: '🐟';
  position: absolute; top:50%; left:50%;
  transform: translate(-50%,-50%);
  font-size: 18rpx;
}

/* 彩色气泡 */
.dm-item.c-pink   { color:#fff; background:linear-gradient(135deg,#ff6b9d,#ffa8c5); }
.dm-item.c-orange { color:#fff; background:linear-gradient(135deg,#ff9a56,#ffc078); }
.dm-item.c-blue   { color:#fff; background:linear-gradient(135deg,#4facfe,#00f2fe); }
.dm-item.c-green  { color:#fff; background:linear-gradient(135deg,#43e97b,#38f9d7); }
.dm-item.c-purple { color:#fff; background:linear-gradient(135deg,#a18cd1,#fbc2eb); }

/* ========== 输入行 ========== */
.dm-input-row {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx 14rpx;
  background: rgba(0,0,0,0.06);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.dm-input-box {
  display: flex; align-items: center; gap: 12rpx;
  flex: 1;
  background: rgba(255,255,255,0.93);
  border-radius: 30rpx;
  padding: 0 8rpx;
}

.dm-input {
  flex: 1; height: 58rpx; padding: 0 20rpx;
  border-radius: 30rpx; font-size: 25rpx;
  background: transparent; color:#333;
  border:none; box-sizing:border-box;
}

/* ========== 发送按钮 ========== */

/* 默认状态 */
.dm-btn {
  flex-shrink: 0;
  width: 110rpx; height: 58rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 30rpx;
  font-size: 25rpx;
  background: #f0f0f0;
  color: #c0c0c0;
  border: 2rpx solid #e0e0e0;
  transition: all 0.2s ease;
}

/* 激活状态 — 强烈视觉对比 */
.dm-btn.active {
  background: linear-gradient(135deg, #FF6B35, #FF3B30);
  color: #ffffff;
  font-weight: bold;
  font-size: 26rpx;
  border-color: transparent;
  box-shadow:
    0 2rpx 12rpx rgba(255,59,48,0.45),
    0 0 24rpx rgba(255,107,53,0.2);
  animation: dm-pulse 1.5s ease-in-out infinite;
}

@keyframes dm-pulse {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.06); }
}

.dm-btn-tap { opacity: 0.85; transform: scale(0.95); }
