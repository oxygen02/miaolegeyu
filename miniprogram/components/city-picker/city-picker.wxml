<view class="city-picker-mask" wx:if="{{show}}" bindtap="onMaskTap">
  <view class="city-picker-content" catchtap="onContentTap">
    <!-- 头部 -->
    <view class="picker-header">
      <text class="cancel-btn" bindtap="onCancel">取消</text>
      <text class="title">选择城市</text>
      <text class="confirm-btn" bindtap="onConfirm">确定</text>
    </view>

    <!-- 定位方式选择 -->
    <view class="location-methods">
      <view class="method-btn {{selectedMethod === 'auto' ? 'active' : ''}}" bindtap="selectMethod" data-method="auto">
        <image class="method-icon-image" src="{{locationIcon}}" mode="aspectFit"/>
        <text class="method-text">自动定位</text>
      </view>
      <view class="method-btn {{selectedMethod === 'search' ? 'active' : ''}}" bindtap="selectMethod" data-method="search">
        <image class="method-icon-image" src="{{searchIcon}}" mode="aspectFit"/>
        <text class="method-text">搜索城市</text>
      </view>
    </view>

    <!-- 自动定位 -->
    <view class="auto-locate-section" wx:if="{{selectedMethod === 'auto'}}">
      <view class="locate-btn-wrapper" bindtap="autoLocate">
        <view class="locate-btn">
          <image class="locate-icon-image" src="{{locationIcon}}" mode="aspectFit"/>
          <text class="locate-text">{{locating ? '定位中...' : '点击获取当前位置'}}</text>
        </view>
      </view>
      
      <view class="located-result" wx:if="{{locatedCity}}">
        <text class="result-label">定位结果：</text>
        <view class="result-city">
          <text class="city-name">{{locatedCity.city}}</text>
          <text class="city-region" wx:if="{{locatedCity.region}}">{{locatedCity.region}}</text>
        </view>
      </view>
    </view>

    <!-- 搜索城市 -->
    <view class="search-section" wx:if="{{selectedMethod === 'search'}}">
      <view class="search-box">
        <image class="search-icon-image" src="{{searchIcon}}" mode="aspectFit"/>
        <input 
          class="search-input" 
          placeholder="输入城市名称，如：成都、北京" 
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          confirm-type="search"
          bindconfirm="performSearch"
        />
        <text class="clear-btn" wx:if="{{searchKeyword}}" bindtap="clearSearch">×</text>
      </view>

      <!-- 搜索结果 -->
      <scroll-view class="search-results" scroll-y wx:if="{{searchResults.length > 0}}">
        <view 
          wx:for="{{searchResults}}" 
          wx:key="code"
          class="result-item {{selectedCity && selectedCity.cityCode === item.code ? 'active' : ''}}"
          bindtap="selectSearchResult"
          data-code="{{item.code}}"
          data-name="{{item.name}}"
          data-province="{{item.province}}"
        >
          <text class="result-name">{{item.name}}</text>
          <text class="result-province">{{item.province}}</text>
        </view>
      </scroll-view>

      <!-- 热门城市 -->
      <view class="hot-cities" wx:if="{{!searchKeyword && !searchResults.length}}">
        <text class="section-title">热门城市</text>
        <view class="hot-grid">
          <view 
            wx:for="{{hotCities}}" 
            wx:key="code"
            class="hot-item {{selectedCity && selectedCity.cityCode === item.code ? 'active' : ''}}"
            bindtap="selectHotCity"
            data-code="{{item.code}}"
            data-name="{{item.name}}"
            data-province="{{item.province}}"
          >{{item.name}}</view>
        </view>
      </view>
    </view>

    <!-- 已选显示 -->
    <view class="selected-bar" wx:if="{{selectedCity || locatedCity}}">
      <text class="selected-label">已选：</text>
      <text class="selected-value">{{selectedText}}</text>
    </view>
  </view>
</view>