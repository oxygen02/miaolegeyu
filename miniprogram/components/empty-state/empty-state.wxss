.empty-state-container {
  min-height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon-wrapper {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-image {
  width: 100%;
  height: 100%;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #E8F4FD 0%, #F5F0E8 100%);
}

.icon-text {
  font-size: 64rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-description {
  font-size: 28rpx;
  color: #999999;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.empty-button {
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, #5B8FF9 0%, #4A7DE4 100%);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(91, 143, 249, 0.3);
}

.button-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}