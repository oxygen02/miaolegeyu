@import "../admin-dashboard/admin-dashboard.wxss";

/* 举报列表 */
.report-list {
  flex: 1;
  padding: 20rpx 24rpx;
}

.report-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.reporter-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.reporter-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #f0f0f0;
}

.reporter-meta {
  display: flex;
  flex-direction: column;
}

.reporter-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.report-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.report-type {
  font-size: 24rpx;
  color: #FF9F43;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.report-reason {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.report-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.report-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

/* 复选框 */
.checkbox-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 12rpx 0;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}

.checkbox.checked {
  background: #FF9F43;
  border-color: #FF9F43;
}

.checkbox-label {
  font-size: 28rpx;
  color: #333;
}
