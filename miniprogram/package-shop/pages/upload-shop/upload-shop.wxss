/* 上传店铺页面 */
.upload-shop-page {
  height: 100vh;
  background: #FFF8F0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部标题 */
.header-section {
  background: linear-gradient(180deg, #FF9F43 0%, #FFB347 100%);
  padding: calc(16rpx + env(safe-area-inset-top)) 32rpx 16rpx;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

/* 表单区域 */
.form-section {
  padding: 16rpx 24rpx;
  flex: 1;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 16rpx;
}

.form-item.required .form-label::before {
  content: '* ';
  color: #FF6B6B;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

/* 输入框提示文字（备注形式） */
.input-hint {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
  line-height: 1.4;
}

/* 合并行 */
.form-row {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.form-row .form-item {
  flex: 1;
  margin-bottom: 16rpx;
}

.flex-1 {
  flex: 1 !important;
}

.flex-2 {
  flex: 2 !important;
}

/* 输入框 - 统一高度 72rpx */
.form-input {
  background: #fff;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #f0f0f0;
  height: 72rpx;
  line-height: 72rpx;
  box-sizing: border-box;
}

/* 价格输入 - 统一高度 72rpx */
.price-input-wrapper {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 8rpx;
  padding: 0 16rpx;
  border: 2rpx solid #f0f0f0;
  height: 72rpx;
  box-sizing: border-box;
}

/* 紧凑模式（合并行内使用） */
.price-input-wrapper.compact {
  height: 60rpx;
  padding: 0 10rpx;
}

.price-symbol {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: 600;
  flex-shrink: 0;
}

.price-input {
  flex: 1;
  border: none;
  padding-left: 6rpx;
  font-size: 28rpx;
  height: 100%;
  min-width: 0;
}

/* 文本域 */
.form-textarea {
  background: #fff;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #f0f0f0;
  width: 100%;
  min-height: 80rpx;
  box-sizing: border-box;
}

.form-textarea.small {
  min-height: 72rpx;
  height: 72rpx;
  line-height: 36rpx;
  padding: 10rpx 16rpx;
}

/* 图片上传区域 */
.image-upload-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  border: 2rpx dashed #FF9F43;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  display: block;
}

.delete-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background: #FF6B6B;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  color: #fff;
  font-size: 24rpx;
  line-height: 1;
}

/* 添加图片按钮 */
.add-image-item {
  width: 140rpx;
  height: 140rpx;
  border: 2rpx dashed #FF9F43;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255,159,67,0.05);
}

.add-icon {
  font-size: 56rpx;
  color: #FF9F43;
  font-weight: 300;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #FF9F43;
  margin-top: 4rpx;
}

.image-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
  text-align: center;
}

/* 菜系标签 */
.cuisine-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cuisine-tag-item {
  padding: 10rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #f0f0f0;
  transition: all 0.2s;
  white-space: nowrap;
}

.cuisine-tag-item.active {
  background: linear-gradient(135deg, #FF9F43 0%, #FFB347 100%);
  color: #fff;
  font-weight: 600;
  border-color: #FF9F43;
}

.cuisine-tag-item.custom {
  border-style: dashed;
  color: #FF9F43;
}

/* 装饰Logo - 喵了个鱼 */
.decoration-logo {
  display: flex;
  justify-content: flex-end;
  margin: -30rpx 0 -50rpx 0;
  padding-right: 60rpx;
  position: relative;
  z-index: 1;
  pointer-events: none;
}

.logo-image {
  width: 140rpx;
  height: 140rpx;
  animation: float 3s ease-in-out infinite;
}

/* 浮动动画 */
@keyframes float {
  0%, 100% {
    transform: translateY(0rpx) rotate(0deg);
  }
  25% {
    transform: translateY(-8rpx) rotate(2deg);
  }
  50% {
    transform: translateY(0rpx) rotate(0deg);
  }
  75% {
    transform: translateY(-4rpx) rotate(-2deg);
  }
}

/* 推荐指数 */
.rating-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.rating-header .form-label {
  margin-bottom: 0;
}

.rating-text {
  font-size: 26rpx;
  color: #FF9F43;
  font-weight: 600;
}

.paw-rating {
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  border: 2rpx solid #f0f0f0;
}

/* 紧凑版推荐指数（用于并列布局） */
.paw-rating.compact {
  gap: 8rpx;
  padding: 0 12rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
}

.paw-item {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.paw-rating.compact .paw-item {
  width: 44rpx;
  height: 44rpx;
}

.paw-image {
  width: 52rpx;
  height: 52rpx;
  opacity: 0.3;
  filter: grayscale(100%);
  transition: all 0.2s;
}

.paw-rating.compact .paw-image {
  width: 40rpx;
  height: 40rpx;
}

.paw-item.active .paw-image {
  opacity: 1;
  filter: grayscale(0%);
}

/* 匿名选项 */
.anonymous-item {
  background: #fff;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
}

.anonymous-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.anonymous-wrapper .form-label {
  margin-bottom: 0;
}

.anonymous-switch {
  transform: scale(0.85);
}

/* 底部按钮 */
.button-section {
  padding: 32rpx 0;
  flex-shrink: 0;
  margin-top: auto;
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.cancel-btn {
  display: block !important;
  width: fit-content !important;
  height: auto !important;
  line-height: 1 !important;
  border-radius: 36rpx !important;
  background: #f5f5f5 !important;
  color: #666 !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border: 4rpx solid #3D3D3D !important;
  box-shadow: 4rpx 4rpx 0 #3D3D3D !important;
  padding: 20rpx 48rpx !important;
  margin: 0 !important;
}

.cancel-btn::after {
  display: none !important;
}

.submit-btn {
  display: block !important;
  width: fit-content !important;
  height: auto !important;
  line-height: 1 !important;
  border-radius: 36rpx !important;
  background: #FF9F43 !important;
  color: #fff !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border: 4rpx solid #3D3D3D !important;
  box-shadow: 4rpx 4rpx 0 #3D3D3D !important;
  padding: 20rpx 56rpx !important;
  margin: 0 !important;
}

.submit-btn::after {
  display: none !important;
}

.submit-btn.disabled {
  background: #ccc !important;
  color: #888 !important;
  border-color: #999 !important;
  box-shadow: 4rpx 4rpx 0 #999 !important;
}

/* 人均消费 + 地点 合并一行 */
.price-location-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.price-location-left {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: 200rpx;
}

.price-location-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

/* 行内标签（不换行） */
.inline-label {
  display: inline-block;
  margin-bottom: 0;
  font-size: 26rpx;
}

/* 地点输入组件 - 支持文字输入和地图选择 */
.location-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.location-group .form-label {
  flex-shrink: 0;
  margin-bottom: 0;
  margin-right: 16rpx;
}

.location-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}

/* 紧凑模式（合并行内使用） */
.location-content.compact {
  gap: 10rpx;
}

.location-input {
  flex: 1;
  text-align: left;
  min-width: 200rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 0 16rpx;
  border: 2rpx solid #f0f0f0;
  height: 60rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.location-map-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F0E8;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.location-icon {
  width: 40rpx;
  height: 40rpx;
}

/* ========== AI智能识别样式（浮动按钮版）========== */

/* 图片上传区域容器（用于定位浮动按钮） */
.image-upload-wrapper {
  position: relative;
}

/* AI智能识别按钮 - 科技星空镭射风格（紧凑版） */
.ai-recognize-float-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 84rpx;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding-left: 16rpx;
  padding-right: 12rpx;
  z-index: 10;

  /* 星际背景 - 深蓝渐变（调亮版本） */
  background:
    radial-gradient(ellipse at 20% 30%, rgba(140, 170, 255, 0.35) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 70%, rgba(190, 150, 255, 0.3) 0%, transparent 50%),
    linear-gradient(135deg, #1a2d4d 0%, #2a4068 30%, #1e3854 60%, #253d5c 100%);

  /* 2D立体效果 - 轻量阴影 */
  box-shadow:
    0 2rpx 8rpx rgba(20, 40, 80, 0.5),
    0 4rpx 16rpx rgba(40, 70, 120, 0.35),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.18),
    inset 0 -1rpx 2rpx rgba(0, 0, 0, 0.25);

  /* 边框 - 科技感发光边缘 */
  border: 1.5rpx solid rgba(130, 170, 255, 0.45);

  /* 镭射动态效果 */
  animation: laserSweep 3s ease-in-out infinite;
  overflow: hidden;
}

/* 镭射扫光层 */
.ai-recognize-float-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(130, 200, 255, 0.18) 25%,
    rgba(170, 150, 255, 0.28) 50%,
    rgba(130, 200, 255, 0.18) 75%,
    transparent 100%
  );
  animation: laserMove 3s ease-in-out infinite;
  border-radius: 32rpx;
}

/* 星际背景粒子（缩小） */
.ai-recognize-float-btn::after {
  content: '✦';
  position: absolute;
  font-size: 11rpx;
  color: rgba(210, 230, 255, 0.65);
  top: 6rpx;
  right: 14rpx;
  animation: starTwinkle 2s ease-in-out infinite;
}

/* AI文字标识 - 科技感发光（紧凑版） */
.ai-text {
  font-size: 24rpx;
  color: #e0e8ff;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1;
  position: relative;
  text-shadow:
    0 0 6rpx rgba(100, 180, 255, 0.5),
    0 0 12rpx rgba(150, 130, 255, 0.35);
}

/* 星星图标 - 绝对定位在AI文字右上角，镭射闪烁效果（紧凑版） */
.ai-star-icon {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  font-size: 16rpx;
  color: #a0d4ff;
  font-weight: bold;
  text-shadow:
    0 0 4rpx rgba(160, 212, 255, 0.85),
    0 0 8rpx rgba(150, 130, 255, 0.6);
  animation: starLaserPulse 1.5s ease-in-out infinite;
}

/* ===== 科技星空镭射动画系统 ===== */

@keyframes laserSweep {
  0%, 100% {
    border-color: rgba(100, 150, 255, 0.4);
    box-shadow:
      0 4rpx 12rpx rgba(0, 10, 30, 0.6),
      0 8rpx 24rpx rgba(20, 40, 80, 0.4),
      inset 0 1rpx 2rpx rgba(255, 255, 255, 0.15),
      inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.3);
  }
  50% {
    border-color: rgba(150, 130, 255, 0.7);
    box-shadow:
      0 4rpx 12rpx rgba(0, 10, 30, 0.6),
      0 8rpx 24rpx rgba(80, 60, 180, 0.5),
      inset 0 1rpx 2rpx rgba(200, 220, 255, 0.25),
      inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.3),
      0 0 20rpx rgba(150, 130, 255, 0.3);
  }
}

@keyframes laserMove {
  0% {
    left: -100%;
  }
  50%, 100% {
    left: 100%;
  }
}

@keyframes starTwinkle {
  0%, 100% {
    opacity: 0.3;
    transform: scale(0.8) rotate(0deg);
  }
  50% {
    opacity: 1;
    transform: scale(1.2) rotate(15deg);
  }
}

@keyframes starLaserPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
    text-shadow:
      0 0 6rpx rgba(160, 212, 255, 0.9),
      0 0 12rpx rgba(150, 130, 255, 0.7);
  }
  50% {
    transform: scale(1.35);
    opacity: 0.85;
    text-shadow:
      0 0 10rpx rgba(160, 212, 255, 1),
      0 0 20rpx rgba(150, 130, 255, 0.9),
      0 0 30rpx rgba(100, 180, 255, 0.5);
  }
}

/* AI提示文字 - 气泡样式 */
.ai-hint-bubble {
  position: absolute;
  top: -20rpx;
  right: 90rpx;
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  white-space: nowrap;
  z-index: 11;
  animation: fadeInOut 1.5s ease-in-out forwards;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

@keyframes fadeInOut {
  0% {
    opacity: 0;
    transform: translateY(10rpx);
  }
  20% {
    opacity: 1;
    transform: translateY(0);
  }
  80% {
    opacity: 1;
    transform: translateY(0);
  }
  100% {
    opacity: 0;
    transform: translateY(-10rpx);
  }
}

/* AI识别进度 - 紧凑内联样式 */
.ai-progress-inline {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #FFFBF5;
  border: 2rpx solid #FFE8CC;
  border-radius: 12rpx;
}

.ai-loading-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.loading-spinner-small {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #FFE8CC;
  border-top-color: #FF9F43;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text-mini {
  font-size: 24rpx;
  color: #FF9F43;
  font-weight: 500;
}

.progress-bar-mini {
  width: 100%;
  height: 8rpx;
  background: #FFE8CC;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill-mini {
  height: 100%;
  background: linear-gradient(90deg, #FF9F43 0%, #FFB347 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.ai-loading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 600;
}

.progress-bar {
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  transition: width 0.3s ease;
  border-radius: 4rpx;
}

