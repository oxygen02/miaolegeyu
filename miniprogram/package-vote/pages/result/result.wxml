<view class="result-page">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <image class="loading-icon" src="{{imagePaths.misc.fishIcon}}" mode="aspectFit"/>
    <text class="loading-text">橘仔正在计算...</text>
  </view>

  <!-- 主要内容 -->
  <block wx:else>
    <!-- 主要内容区域 -->
    <view class="result-content">
      <!-- Mode A: 海报投票结果 -->
      <block wx:if="{{mode === 'a'}}">
        <result-card
          title="橘仔宣布"
          subtitle="本次聚会地点已定"
          poster-image-url="{{room.finalPoster.imageUrl}}"
          platform-source="{{room.finalPoster.platformSource}}"
          show-vote-stats="{{true}}"
          vote-percent="{{room.finalPoster.votePercent || 67}}"
          voters="{{room.participants}}"
          shop-name="{{room.finalPoster.shopName}}"
          time="{{room.finalPoster.time}}"
          address="{{room.finalPoster.address}}"
          show-room-addition="{{true}}"
          room-addition="{{roomAddition}}"
          bind:previewPoster="previewPoster"
          bind:copyAddress="copyAddress"
          bind:openNavigation="openNavigation"
          bind:addToCalendar="addToCalendar"
          bind:roomAdditionInput="onRoomAdditionInput"
          bind:saveRoomAddition="saveRoomAddition"
          bind:showPoster="showResultPoster"
        >
          <!-- 自定义操作区域 -->
          <view slot="actions" wx:if="{{room.groupOrderOption}}">
            <button class="btn-settlement" bindtap="goSettlement">
              <image class="btn-settlement-icon" src="{{imagePaths.icons.sharetofriends}}" mode="aspectFit"/>
              <text>去结算</text>
            </button>
          </view>
        </result-card>
      </block>

      <!-- Mode B: 分类投票结果 -->
      <block wx:if="{{mode === 'b' && voteStats}}">
        <view class="modeb-result-section">
          <view class="best-matches-card" wx:if="{{voteStats.bestMatches.length > 0}}">
            <text class="section-title">最佳匹配</text>
            <view class="match-list">
              <view class="match-item {{item.matchType}}" wx:for="{{voteStats.bestMatches}}" wx:key="index">
                <view class="match-rank">{{index + 1}}</view>
                <view class="match-info">
                  <text class="match-name">{{item.categoryName}} · {{item.subCategoryName}}</text>
                  <view class="match-meta">
                    <text class="match-tag">{{item.matchType === 'perfect' ? '完美' : '部分'}}</text>
                    <text class="match-rate">{{item.matchRate}}%</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <view class="category-stats-card" wx:if="{{voteStats.categoryStats.length > 0}}">
            <text class="section-title">详细统计</text>
            <view wx:for="{{voteStats.categoryStats}}" wx:key="categoryId">
              <view class="category-item">
                <text class="category-name">{{item.categoryName}}</text>
                <view class="sub-items">
                  <view class="sub-item" wx:for="{{item.perfectMatch}}" wx:key="name">
                    <text class="sub-name">{{item.name}}</text>
                    <text class="sub-count">{{item.count}}人</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <view class="taboo-card" wx:if="{{voteStats.hardTabooStats && Object.keys(voteStats.hardTabooStats).length > 0}}">
            <text class="section-title">共同禁忌</text>
            <view class="taboo-list">
              <text class="taboo-tag" wx:for="{{voteStats.hardTabooStats}}" wx:key="*this">{{item}}</text>
            </view>
          </view>

          <view class="recommend-card" wx:if="{{room.enableRestaurantRecommend}}" bindtap="goRecommendRestaurant">
            <text class="recommend-title">推荐附近餐厅</text>
            <text class="recommend-arrow">去看看 ></text>
          </view>

          <view class="share-section">
            <view class="share-row">
              <button class="share-btn" open-type="share">
                <image class="share-icon" src="{{imagePaths.icons.sharetofriends}}" mode="aspectFit"/>
                <text>分享</text>
              </button>
              <view class="share-btn" bindtap="showResultPoster">
                <image class="share-icon" src="{{imagePaths.icons.gaizhang}}" mode="aspectFit"/>
                <text>海报</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- 无结果状态 -->
      <block wx:if="{{!room.finalPoster && mode !== 'b'}}">
        <view class="no-result-section">
          <image class="no-result-avatar" src="{{imagePaths.banners.faqijucan}}" mode="aspectFill"/>
          <text class="no-result-text">还没有最终结果哦</text>
          <text class="no-result-hint">等橘仔选好了会通知你~</text>
        </view>
      </block>
    </view>
  </block>

  <!-- 海报分享弹窗 -->
  <poster-modal 
    visible="{{showPosterModal}}"
    poster-data="{{posterData}}"
    bind:close="onPosterClose"
    bind:save="onPosterSave"
    bind:shareFriend="onPosterShareFriend"
  />
</view>