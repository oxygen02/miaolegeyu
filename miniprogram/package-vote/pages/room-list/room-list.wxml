<wxs module="utils">
module.exports = {
  safeString: function(value) {
    if (!value) return '';
    if (typeof value === 'string') return value;
    if (typeof value === 'number') return String(value);
    if (typeof value === 'object') {
      if (value.name) return value.name;
      if (value.address) return value.address;
      if (value.text) return value.text;
      return '';
    }
    return String(value);
  }
}
</wxs>

<view class="room-list-page">
  <!-- 页面标题和房间号输入合并 -->
  <view class="page-header">
    <view class="header-left">
      <text class="page-title">投票列表</text>
      <text class="page-subtitle">点击卡片参与投票</text>
    </view>
    <view class="header-right">
      <view class="input-wrapper-inline {{inputFocused ? 'focused' : ''}}">
        <input 
          class="room-input-inline" 
          type="text" 
          placeholder="输入房间号" 
          value="{{inputRoomId}}"
          bindinput="onRoomIdInput"
          bindfocus="onInputFocus"
          bindblur="onInputBlur"
          maxlength="20"
        />
        <view class="enter-btn-inline" bindtap="enterRoomById">
          <text>进入</text>
        </view>
      </view>
    </view>
    <image class="header-tail" src="{{imagePaths.banners.maoweiba}}" mode="aspectFit" />
  </view>

  <!-- 筛选标签 -->
  <view class="filter-tabs">
    <view class="tab-item {{currentFilter === 'all' ? 'active' : ''}}" bindtap="switchFilter" data-filter="all">
      <text>全部</text>
    </view>
    <view class="tab-item {{currentFilter === 'active' ? 'active' : ''}}" bindtap="switchFilter" data-filter="active">
      <text>进行中</text>
    </view>
    <view class="tab-item {{currentFilter === 'locked' ? 'active' : ''}}" bindtap="switchFilter" data-filter="locked">
      <text>已结束</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!loading && allRooms.length === 0}}">
    <image class="empty-icon" src="{{imagePaths.decorations.sleepingCatIcon}}" mode="aspectFit" />
    <text class="empty-text">暂无投票活动</text>
    <text class="empty-subtext">输入房间号或等待邀请</text>
  </view>

  <!-- 活动列表 - 横条样式 -->
  <view class="room-list" wx:else>
    <view 
      class="room-item {{cardColors[index % cardColors.length]}}" 
      wx:for="{{allRooms}}" 
      wx:for-index="index"
      wx:key="roomId"
      bindtap="goToRoom"
      data-roomid="{{item.roomId}}"
    >
      <!-- 左侧海报 -->
      <view class="item-poster">
        <image
          src="{{item.finalPoster || (item.candidatePosters[0] && item.candidatePosters[0].imageUrl) || imagePaths.banners.taiyakiIcon}}"
          mode="aspectFill"
          catchtap="previewImage"
          data-src="{{item.finalPoster || (item.candidatePosters[0] && item.candidatePosters[0].imageUrl)}}"
        />
      </view>

      <!-- 中间信息 -->
      <view class="item-info">
        <view class="info-header">
          <text class="item-title">{{item.title}}</text>
          <view class="status-badge {{item.status}}">
            {{item.status === 'voting' ? '进行中' : (item.status === 'ended' ? '已过期' : '已结束')}}
          </view>
        </view>

        <view class="info-detail">
          <!-- 普通投票：显示日期和时间 -->
          <view class="detail-row" wx:if="{{!item.isScheduleVote && (utils.safeString(item.activityDate) || utils.safeString(item.activityTime))}}">
            <image class="detail-icon" src="{{imagePaths.icons.calendar}}" mode="aspectFit" />
            <text class="detail-text">{{utils.safeString(item.activityDate)}} {{utils.safeString(item.activityTime)}}</text>
          </view>
          <!-- 时间投票：显示候选日期 -->
          <view class="detail-row" wx:if="{{item.isScheduleVote && utils.safeString(item.location)}}">
            <image class="detail-icon" src="{{imagePaths.icons.calendar}}" mode="aspectFit" />
            <text class="detail-text">候选: {{utils.safeString(item.location)}}</text>
          </view>
          <!-- 时间投票：显示截止时间 -->
          <view class="detail-row" wx:if="{{item.isScheduleVote && utils.safeString(item.activityTime)}}">
            <image class="detail-icon" src="{{imagePaths.icons.clock}}" mode="aspectFit" />
            <text class="detail-text">截止: {{utils.safeString(item.activityTime)}}</text>
          </view>
          <view class="detail-row" wx:if="{{!item.isScheduleVote && utils.safeString(item.location)}}">
            <image class="detail-icon" src="{{imagePaths.icons.location}}" mode="aspectFit" />
            <text class="detail-text">{{utils.safeString(item.location)}}</text>
          </view>
        </view>

        <view class="info-footer">
          <image class="creator-avatar-mini" src="{{item.creatorAvatar || item.creatorAvatarUrl || imagePaths.decorations.catAvatarIcon}}" mode="aspectFit" />
          <text class="creator-name-mini">{{item.creatorName || item.creatorNickName}}</text>
          <text class="room-id">房间号: {{item.displayRoomId || item.roomId}}</text>
        </view>
      </view>

    </view>

    <!-- 底部留白 -->
    <view class="bottom-space"></view>
  </view>
</view>
