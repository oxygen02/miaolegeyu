.container {
  min-height: 100vh;
  background: #F5F0E8;
  padding: 24rpx;
  box-sizing: border-box;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
  font-size: 28rpx;
}

/* 标题区域 */
.header-section {
  background: linear-gradient(135deg, #FF9F43 0%, #FFB347 100%);
  border-radius: 20rpx;
  padding: calc(40rpx + env(safe-area-inset-top)) 32rpx 40rpx;
  margin-bottom: 24rpx;
  text-align: center;
  position: relative;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  margin-bottom: 20rpx;
}

.participants-count {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.count-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.count-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 选项区域 */
.options-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D3D3D;
  margin-bottom: 20rpx;
  display: block;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 3rpx solid #3D3D3D;
  border-bottom: 6rpx solid #3D3D3D;
  border-right: 6rpx solid #3D3D3D;
  display: flex;
  flex-direction: column;
  gap: 0;
  transition: all 0.2s ease;
}

.option-card.selected {
  border-color: #FF9F43;
  background: #FFF8F0;
}

.option-card.joined {
  border-color: #4CAF50;
  background: #F1F8E9;
}

.option-image-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid #3D3D3D;
  flex-shrink: 0;
}

.option-image {
  width: 100%;
  height: 100%;
}

.option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.option-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.option-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D3D3D;
}

.option-badge {
  background: #4CAF50;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.option-platform {
  font-size: 26rpx;
  color: #666;
}

.option-deadline {
  font-size: 24rpx;
  color: #999;
}

.option-stats {
  margin-top: 8rpx;
}

.stats-text {
  font-size: 24rpx;
  color: #FF9F43;
  font-weight: 500;
}

.progress-bar {
  height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #FF9F43;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 操作区域 */
.action-section {
  padding: 32rpx 0;
  flex-shrink: 0;
  margin-top: auto;
}

.btn {
  display: block !important;
  width: fit-content !important;
  height: auto !important;
  line-height: 1 !important;
  border-radius: var(--radius-xl) !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border: 4rpx solid var(--text) !important;
  box-shadow: 4rpx 4rpx 0 var(--text) !important;
  text-align: center;
  padding: 20rpx 56rpx !important;
  margin: 0 auto !important;
}

.btn::after {
  display: none !important;
}

.btn-primary {
  background: var(--primary) !important;
  color: #fff !important;
}

.btn-primary[disabled] {
  background: #CCC !important;
  color: #888 !important;
  border-color: #999 !important;
  box-shadow: 4rpx 4rpx 0 #999 !important;
}

.btn-success {
  background: #4CAF50;
  color: #fff;
}

.btn-success[disabled] {
  background: #81C784;
  color: #fff;
  border-color: #4CAF50;
  box-shadow: 4rpx 4rpx 0 #4CAF50;
}

.btn-loading {
  opacity: 0.8;
}

/* 提示信息 */
.tips-section {
  margin-top: 24rpx;
  text-align: center;
}

.tips-text {
  font-size: 24rpx;
  color: #999;
}

/* ===== 选项卡片布局调整 ===== */
.option-main {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  width: 100%;
}

.option-detail-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 20rpx;
  margin-top: 10rpx;
  border-top: 2rpx dashed #E0E0E0;
  color: #FF9F43;
  font-size: 24rpx;
  font-weight: 500;
  width: 100%;
  box-sizing: border-box;
}

.detail-btn-text {
  color: #FF9F43;
}

.detail-btn-arrow {
  font-size: 28rpx;
  color: #FF9F43;
  margin-left: 4rpx;
}

/* ===== 选项详情弹窗 ===== */
.option-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.detail-modal-content {
  background: #F5F0E8;
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
  box-sizing: border-box;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.detail-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #E0E0E0;
  flex-shrink: 0;
}

.detail-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D3D3D;
}

.detail-modal-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999;
  background: #E8E4DC;
  border-radius: 50%;
}

.detail-modal-body {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.detail-option-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D3D3D;
  display: block;
  margin-bottom: 16rpx;
}

/* 详情图片 */
.detail-image-section {
  margin-bottom: 20rpx;
  text-align: center;
}

.detail-option-image {
  width: 100%;
  max-height: 320rpx;
  border-radius: 12rpx;
  border: 2rpx solid #3D3D3D;
  display: block;
}

.image-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

/* 信息列表 */
.detail-info-list {
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #3D3D3D;
  border-bottom: 4rpx solid #3D3D3D;
  border-right: 4rpx solid #3D3D3D;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.detail-info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #F0F0F0;
}

.detail-info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #3D3D3D;
  font-weight: 500;
}

/* 链接区域 */
.detail-link-section {
  margin-bottom: 24rpx;
}

.link-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D3D3D;
  margin-bottom: 12rpx;
  display: block;
}

.link-box {
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #3D3D3D;
  border-bottom: 4rpx solid #3D3D3D;
  border-right: 4rpx solid #3D3D3D;
  padding: 16rpx 20rpx;
}

.link-text {
  font-size: 26rpx;
  color: #FF9F43;
  word-break: break-all;
  display: block;
  margin-bottom: 8rpx;
}

.link-hint {
  font-size: 22rpx;
  color: #999;
}

/* 统计区域 */
.detail-stats-section {
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #3D3D3D;
  border-bottom: 4rpx solid #3D3D3D;
  border-right: 4rpx solid #3D3D3D;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.stats-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D3D3D;
  margin-bottom: 16rpx;
  display: block;
}

.detail-progress-bar {
  height: 16rpx;
  background: #E0E0E0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.detail-progress-fill {
  height: 100%;
  background: #FF9F43;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.stats-percent {
  font-size: 24rpx;
  color: #666;
}

/* 弹窗底部 */
.detail-modal-footer {
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #E0E0E0;
  display: flex;
  justify-content: center;
}

.detail-modal-footer .btn {
  width: auto !important;
  min-width: 200rpx;
  margin: 0 auto !important;
  padding: 12rpx 40rpx !important;
  font-size: 26rpx !important;
  border-radius: 40rpx !important;
  border-width: 2rpx !important;
  box-shadow: 2rpx 2rpx 0 var(--text) !important;
}

.detail-modal-footer .btn-success {
  background: #E8F5E9 !important;
  color: #4CAF50 !important;
  border-color: #4CAF50 !important;
  box-shadow: 2rpx 2rpx 0 #4CAF50 !important;
}

.detail-modal-footer .btn-primary {
  background: #FFF3E0 !important;
  color: #FF9F43 !important;
  border-color: #FF9F43 !important;
  box-shadow: 2rpx 2rpx 0 #FF9F43 !important;
}

.btn-secondary {
  background: #fff;
  color: #3D3D3D;
  border: 2rpx solid #3D3D3D;
  box-shadow: 2rpx 2rpx 0 #3D3D3D;
}
